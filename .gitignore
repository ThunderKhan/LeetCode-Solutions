# =====================================================
# Universal .gitignore
# Covers Python, C, C++, Java, JavaScript, TypeScript,
# Rust, Go, C#, Swift, Kotlin, IDEs, OS files, and more.
# =====================================================

########################
# Operating System
########################

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

Thumbs.db
Desktop.ini
$RECYCLE.BIN/

########################
# Logs
########################

*.log
logs/
*.out
*.err
*.pid
*.pid.lock

########################
# Temporary Files
########################

tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

########################
# Environment Variables
########################

.env
.env.*
!.env.example

########################
# Archives
########################

*.zip
*.tar
*.gz
*.tgz
*.7z
*.rar
*.xz

########################
# Python
########################

__pycache__/
*.py[cod]
*$py.class

*.so

.Python
